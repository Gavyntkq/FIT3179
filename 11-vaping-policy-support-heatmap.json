
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Support for measures to reduce nicotine-related harm by age group in Australia, 2025. Source: AIHW NDSHS 2025, Table 2.56.",
  "title": {
    "text": "Support for vaping controls differs by age",
    "subtitle": "Percentage who support or strongly support each measure, Australia, 2025"
  },
  "data": {
