        "70+": 75.8
      }
    ]
  },
  "transform": [
    {
      "fold": [
        "14–17",
        "18–24",
        "25–29",
        "30–39",
        "40–49",
        "50–59",
        "60–69",
        "70+"
      ],
      "as": ["age_group", "support_percent"]
    }
  ],
  "width": 900,
  "height": 250,
  "encoding": {
    "x": {
      "field": "age_group",
      "type": "ordinal",
      "sort": [
        "14–17",
        "18–24",
        "25–29",
        "30–39",
        "40–49",
        "50–59",
        "60–69",
        "70+"
      ],
      "axis": {
        "title": "Age group (years)",
        "labelAngle": 0,
        "labelFontSize": 11,
        "titleFontSize": 12,
        "domain": false,
        "tickSize": 0,
        "labelPadding": 8
      }
    },
    "y": {
      "field": "measure",
      "type": "ordinal",
      "sort": [
        "Restrict sales to pharmacies",
        "Require product packaging and labels",
        "Ban attractive additives",
        "Restrict other nicotine products"
      ],
      "axis": {
        "title": null,
        "labelFontSize": 11,
        "labelLimit": 230,
        "labelPadding": 10,
        "domain": false,
        "tickSize": 0
      }
    },
    "color": {
      "field": "support_percent",
      "type": "quantitative",
      "title": "Support (%)",
      "scale": {
        "domain": [60, 95],
        "range": ["#e5f1e8", "#176443"],
        "clamp": true
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 300,
        "titleFontSize": 12,
        "labelFontSize": 11
      }
    },
    "tooltip": [
      {
        "field": "measure",
        "type": "nominal",
        "title": "Measure"
      },
      {
        "field": "age_group",
        "type": "nominal",
        "title": "Age group"
      },
      {
        "field": "support_percent",
        "type": "quantitative",
        "title": "Support (%)",
        "format": ".1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 2,
        "cornerRadius": 2
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "support_percent",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.support_percent >= 80",
            "value": "#ffffff"
          },
          "value": "#173d31"
        }
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "view": {
