
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Tile-style cartogram of age-standardised daily smoking prevalence across Australian states and territories in 2022. Tile area is proportional to prevalence.",
  "title": {
    "text": "Comparing daily smoking prevalence across jurisdictions",
    "subtitle": "Tile cartogram: square area represents age-standardised daily smoking prevalence, 2022"
  },
  "width": 1200,
  "height": 520,
  "data": {
    "values": [
      {
        "state": "Western Australia",
        "abbr": "WA",
        "rate": 10.7,
        "x0": 12,
        "y0": 38
      },
      {
        "state": "Northern Territory",
        "abbr": "NT",
        "rate": 13.1,
        "x0": 35,
        "y0": 57
      },
      {
        "state": "Queensland",
        "abbr": "QLD",
        "rate": 14.4,
        "x0": 54,
        "y0": 54
      },
      {
        "state": "South Australia",
        "abbr": "SA",
        "rate": 9.7,
        "x0": 35,
        "y0": 34
      },
      {
        "state": "New South Wales",
        "abbr": "NSW",
        "rate": 10.0,
        "x0": 55,
        "y0": 32
      },
      {
        "state": "Victoria",
        "abbr": "VIC",
        "rate": 9.2,
        "x0": 53,
        "y0": 12
      },
      {
        "state": "Tasmania",
        "abbr": "TAS",
        "rate": 13.0,
        "x0": 69,
        "y0": -3
      },
      {
        "state": "Australian Capital Territory",
        "abbr": "ACT",
        "rate": 5.9,
        "x0": 77,
        "y0": 34
      }
    ]
  },
  "transform": [
    {
      "calculate": "sqrt(datum.rate) * 4",
      "as": "tile_side"
    },
    {
      "calculate": "datum.x0 + datum.tile_side",
      "as": "x1"
    },
    {
      "calculate": "datum.y0 + datum.tile_side",
      "as": "y1"
    },
    {
      "calculate": "datum.x0 + datum.tile_side / 2",
      "as": "x_mid"
    },
    {
      "calculate": "datum.y0 + datum.tile_side / 2",
      "as": "y_mid"
    },
    {
      "calculate": "datum.abbr + '\\n' + format(datum.rate, '.1f') + '%'",
      "as": "tile_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "fill": "#397c5b",
        "stroke": "#ffffff",
        "strokeWidth": 2,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [0, 120],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [-10, 86],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Age-standardised daily smoking (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#ffffff",
        "align": "center",
        "baseline": "middle",
        "lineBreak": "\n"
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative",
          "scale": {
            "domain": [0, 120],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "y": {
          "field": "y_mid",
          "type": "quantitative",
          "scale": {
            "domain": [-10, 86],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "text": {
          "field": "tile_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Arial",
      "fontSize": 17,
      "subtitleFontSize": 12,
      "anchor": "start",
      "color": "#173d31",
      "subtitleColor": "#526b60"
    }
  }
}
