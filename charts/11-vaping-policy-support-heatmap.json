
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap showing support for vaping and nicotine control policies across Australian age groups.",
  "title": {
    "text": "Support for vaping controls varies by policy and age",
    "subtitle": "Percentage supporting selected controls, by age group"
  },
  "data": {
    "values": [
      {"policy":"Restrict sales to pharmacies","age_group":"14–17","support":82.9},
      {"policy":"Restrict sales to pharmacies","age_group":"18–24","support":67.7},
      {"policy":"Restrict sales to pharmacies","age_group":"25–29","support":68.2},
      {"policy":"Restrict sales to pharmacies","age_group":"30–39","support":71.0},
      {"policy":"Restrict sales to pharmacies","age_group":"40–49","support":73.5},
      {"policy":"Restrict sales to pharmacies","age_group":"50–59","support":78.0},
      {"policy":"Restrict sales to pharmacies","age_group":"60–69","support":77.7},
      {"policy":"Restrict sales to pharmacies","age_group":"70+","support":82.7},

      {"policy":"Require product packaging and labels","age_group":"14–17","support":85.7},
      {"policy":"Require product packaging and labels","age_group":"18–24","support":81.3},
      {"policy":"Require product packaging and labels","age_group":"25–29","support":79.9},
      {"policy":"Require product packaging and labels","age_group":"30–39","support":76.7},
      {"policy":"Require product packaging and labels","age_group":"40–49","support":79.2},
      {"policy":"Require product packaging and labels","age_group":"50–59","support":82.7},
      {"policy":"Require product packaging and labels","age_group":"60–69","support":82.6},
      {"policy":"Require product packaging and labels","age_group":"70+","support":87.8},

      {"policy":"Ban attractive additives","age_group":"14–17","support":86.1},
      {"policy":"Ban attractive additives","age_group":"18–24","support":74.2},
      {"policy":"Ban attractive additives","age_group":"25–29","support":76.3},
      {"policy":"Ban attractive additives","age_group":"30–39","support":77.2},
      {"policy":"Ban attractive additives","age_group":"40–49","support":80.3},
      {"policy":"Ban attractive additives","age_group":"50–59","support":85.4},
      {"policy":"Ban attractive additives","age_group":"60–69","support":86.6},
      {"policy":"Ban attractive additives","age_group":"70+","support":91.4},

      {"policy":"Restrict other nicotine products","age_group":"14–17","support":76.4},
      {"policy":"Restrict other nicotine products","age_group":"18–24","support":67.0},
      {"policy":"Restrict other nicotine products","age_group":"25–29","support":66.5},
      {"policy":"Restrict other nicotine products","age_group":"30–39","support":61.8},
      {"policy":"Restrict other nicotine products","age_group":"40–49","support":64.9},
      {"policy":"Restrict other nicotine products","age_group":"50–59","support":64.5},
      {"policy":"Restrict other nicotine products","age_group":"60–69","support":65.8},
      {"policy":"Restrict other nicotine products","age_group":"70+","support":75.8}
    ]
  },
  "transform": [
    {
      "calculate": "format(datum.support, '.1f') + '%'",
      "as": "support_label"
    }
  ],
  "width": "container",
  "height": 250,
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 2,
        "cornerRadius": 2
      },
      "encoding": {
        "x": {
          "field": "age_group",
          "type": "ordinal",
          "sort": ["14–17", "18–24", "25–29", "30–39", "40–49", "50–59", "60–69", "70+"],
          "title": "Age group (years)",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 11,
            "labelPadding": 7,
            "tickSize": 0,
            "domain": false
          }
        },
        "y": {
          "field": "policy",
          "type": "ordinal",
          "sort": [
            "Restrict sales to pharmacies",
            "Require product packaging and labels",
            "Ban attractive additives",
            "Restrict other nicotine products"
          ],
          "title": "Policy",
          "axis": {
            "labelFontSize": 11,
            "labelLimit": 230,
            "labelPadding": 8,
            "tickSize": 0,
            "domain": false
          }
        },
        "color": {
          "field": "support",
          "type": "quantitative",
          "title": "Support (%)",
          "scale": {
            "domain": [60, 95],
            "range": ["#e5f3e8", "#176b45"],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 250,
            "format": ".0f"
          }
        },
        "tooltip": [
          {"field": "policy", "type": "nominal", "title": "Policy"},
          {"field": "age_group", "type": "ordinal", "title": "Age group"},
          {"field": "support", "type": "quantitative", "title": "Supporting (%)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "age_group",
          "type": "ordinal",
          "sort": ["14–17", "18–24", "25–29", "30–39", "40–49", "50–59", "60–69", "70+"]
        },
        "y": {
          "field": "policy",
          "type": "ordinal",
          "sort": [
            "Restrict sales to pharmacies",
            "Require product packaging and labels",
            "Ban attractive additives",
            "Restrict other nicotine products"
          ]
        },
        "text": {"field": "support_label", "type": "nominal"},
        "color": {
          "condition": {
            "test": "datum.support >= 78",
            "value": "#ffffff"
          },
          "value": "#173d31"
        }
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {
      "grid": false,
      "labelColor": "#355344",
      "titleColor": "#355344",
      "titleFontSize": 12
    },
    "title": {
      "anchor": "start",
      "color": "#174333",
      "fontSize": 17,
      "subtitleColor": "#607468",
      "subtitleFontSize": 12,
      "offset": 12
    }
  }
}
