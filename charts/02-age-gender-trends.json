{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Daily smoking prevalence by age group and sex, based on AIHW NDSHS Table 1.4.",
  "title": {
    "text": "Smoking patterns differ across age groups",
    "subtitle": "Daily smoking prevalence by age and sex, 2001–2025"
  },
  "data": {
    "url": "data/age_gender_daily_smoking.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "isValid(datum.source_flag) && datum.source_flag !== '' ? datum.source_flag : 'No flag'",
      "as": "source_flag_display"
    }
  ],
  "facet": {
    "column": {
      "field": "sex",
      "type": "nominal",
      "title": null,
      "sort": [
        "males",
        "females"
      ]
    }
  },
  "spec": {
    "width": 420,
    "height": 340,
    "mark": {
      "type": "line",
      "point": true,
      "strokeWidth": 2
    },
    "encoding": {
      "x": {
        "field": "year",
        "type": "ordinal",
        "sort": [
          "2001",
          "2004",
          "2007",
          "2010",
          "2013",
          "2016",
          "2019",
          "2022–2023",
          "2025"
        ],
        "title": "Survey year",
        "axis": {
          "labelAngle": -45
        }
      },
      "y": {
        "field": "daily_smoking_percent",
        "type": "quantitative",
        "title": "Daily smokers (%)",
        "scale": {
          "zero": true
        }
      },
      "color": {
        "field": "age_group",
        "type": "nominal",
        "title": "Age group",
        "scale": {
          "scheme": "tableau10"
        },
        "legend": {
          "orient": "right",
          "direction": "vertical",
          "columns": 1,
          "labelLimit": 120,
          "symbolSize": 90,
          "padding": 10,
          "offset": 15
        }
      },
      "detail": {
        "field": "age_group"
      },
      "tooltip": [
        {
          "field": "sex",
          "title": "Sex"
        },
        {
          "field": "age_group",
          "title": "Age group"
        },
        {
          "field": "year",
          "title": "Year"
        },
        {
          "field": "daily_smoking_percent",
          "title": "Daily smoking (%)",
          "format": ".1f"
        },
        {
          "field": "source_flag_display",
          "title": "Source flag"
        }
      ]
    }
  },
  "resolve": {
    "scale": {
      "y": "shared",
      "color": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#e5ebe7",
      "labelColor": "#40594b",
      "titleColor": "#244b37"
    },
    "title": {
      "font": "Arial",
      "fontSize": 17,
      "subtitleFontSize": 12,
      "anchor": "start",
      "color": "#173d31",
      "subtitleColor": "#526b60"
    }
  }
}
