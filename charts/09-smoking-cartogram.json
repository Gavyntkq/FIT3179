
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Compact tile cartogram comparing age-standardised daily smoking prevalence across Australian states and territories in 2022. Square areas are proportional to prevalence.",
  "title": {
    "text": "Daily smoking prevalence across Australian jurisdictions",
    "subtitle": "2022 age-standardised daily smoking prevalence (%) · Larger tiles indicate higher prevalence"
  },
  "width": 600,
  "height": 420,
  "data": {
    "values": [
      {"state": "Western Australia", "abbr": "WA", "rate": 10.7, "x": 8, "y": 25},
      {"state": "Northern Territory", "abbr": "NT", "rate": 13.1, "x": 29, "y": 43},
      {"state": "Queensland", "abbr": "QLD", "rate": 14.4, "x": 44, "y": 43},
      {"state": "South Australia", "abbr": "SA", "rate": 9.7, "x": 29, "y": 27},
      {"state": "New South Wales", "abbr": "NSW", "rate": 10.0, "x": 45, "y": 27},
      {"state": "Australian Capital Territory", "abbr": "ACT", "rate": 5.9, "x": 60, "y": 27},
      {"state": "Victoria", "abbr": "VIC", "rate": 9.2, "x": 44, "y": 11},
      {"state": "Tasmania", "abbr": "TAS", "rate": 13.0, "x": 59, "y": 3}
    ]
  },
  "transform": [
    {
      "calculate": "sqrt(datum.rate) * 3.5",
      "as": "side"
    },
    {
      "calculate": "datum.x + datum.side",
      "as": "x2"
    },
    {
      "calculate": "datum.y + datum.side",
      "as": "y2"
    },
    {
      "calculate": "datum.x + datum.side / 2",
      "as": "xmid"
    },
    {
      "calculate": "datum.y + datum.side / 2",
      "as": "ymid"
    },
    {
      "calculate": "datum.abbr + '\\n' + format(datum.rate, '.1f') + '%'",
      "as": "label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "fill": "#397c5b",
        "stroke": "#ffffff",
        "strokeWidth": 2,
        "cornerRadius": 3
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": {
            "domain": [0, 86],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "x2": {"field": "x2"},
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [0, 60],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "y2": {"field": "y2"},
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Daily smoking prevalence (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#ffffff",
        "align": "center",
        "baseline": "middle",
        "lineBreak": "\n"
      },
      "encoding": {
        "x": {
          "field": "xmid",
          "type": "quantitative",
          "scale": {
            "domain": [0, 86],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "y": {
          "field": "ymid",
          "type": "quantitative",
          "scale": {
            "domain": [0, 60],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Arial",
      "fontSize": 17,
      "subtitleFontSize": 12,
      "anchor": "start",
      "color": "#173d31",
      "subtitleColor": "#526b60",
      "offset": 12
    }
  }
}
